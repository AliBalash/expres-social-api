BUNDLESOCIAL_API_KEY=your_api_key_here
BUNDLESOCIAL_WEBHOOK_SECRET=your_webhook_secret
BUNDLESOCIAL_REDIRECT_URL=http://localhost:3000/instagram/callback
BUNDLESOCIAL_DEFAULT_TEAM_NAME=Instagram Demo Team
BUNDLESOCIAL_DEFAULT_TEAM_TIER=FREE
### Optional portal defaults
BUNDLESOCIAL_DEFAULT_PORTAL_LANGUAGE=en
BUNDLESOCIAL_PORTAL_USER_NAME=My Brand
BUNDLESOCIAL_PORTAL_LOGO_URL=https://example.com/logo.png
BUNDLESOCIAL_PORTAL_USER_LOGO_URL=https://example.com/user.png
### Optional publish defaults
BUNDLESOCIAL_DEFAULT_POST_TYPE=POST
BUNDLESOCIAL_DEFAULT_POST_STATUS=SCHEDULED
BUNDLESOCIAL_DEFAULT_SHARE_TO_FEED=false
BUNDLESOCIAL_DEFAULT_POST_DELAY_MINUTES=0
PORT=3000

### Optional defaults for easier local testing (not required)
# BUNDLESOCIAL_DEFAULT_TEAM_ID=
# BUNDLESOCIAL_DEFAULT_INSTAGRAM_SOCIAL_ACCOUNT_ID=
# BUNDLESOCIAL_DEFAULT_INSTAGRAM_USERNAME=
